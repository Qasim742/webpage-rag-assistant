{
    "manifest_version": 3,
    "name": "Webpage RAG Assistant",
    "version": "1.0.0",
    "description": "Ask questions about the current webpage using Retrieval-Augmented Generation.",
    "permissions": [
        "tabs",
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "http://127.0.0.1/*",
        "http://localhost/*"
    ],
    "optional_host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "options_page": "options.html"
}